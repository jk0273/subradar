# ════════════════════════════════════════
#  SubRadar — Environment Variables
#  Copy to .env.local and fill in values
# ════════════════════════════════════════

# App
NEXT_PUBLIC_APP_URL=https://subradar.fr

# ── Supabase ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Anthropic (Claude AI) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail OAuth ───────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Stripe ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_FAMILLE_PRICE_ID=price_...

# ── Resend (emails) ───────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@subradar.fr

# ── Cron security ─────────────────────────
CRON_SECRET=generate-a-random-32-char-string-here

# ── Optional: Sentry ──────────────────────
# SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_DSN=https://...

# ── Optional: PostHog ─────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
